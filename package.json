{
  "name": "@oxygenui-design/datagrid",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc --build",
    "test": "pnpm build && vitest run",
    "test:watch": "pnpm build && vitest",
    "lint:layers": "pnpm build && depcruise packages --config .dependency-cruiser.cjs",
    "size": "turbo run size",
    "gate": "pnpm typecheck && pnpm test && pnpm lint:layers && pnpm size && pnpm size:composed && pnpm typecheck:playground && pnpm smoke:playground",
    "changeset": "changeset",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo .turbo",
    "bench": "pnpm build && node --expose-gc bench/run.mjs",
    "bench:check": "pnpm build && node --expose-gc bench/run.mjs --check",
    "bench:write": "pnpm build && node --expose-gc bench/run.mjs --write",
    "bench:browser": "pnpm build && node bench/browser.mjs",
    "bench:browser:check": "pnpm build && node bench/browser.mjs --check",
    "bench:browser:write": "pnpm build && node bench/browser.mjs --write",
    "playground": "pnpm build && node examples/playground/build.mjs --watch",
    "playground:build": "pnpm build && node examples/playground/build.mjs",
    "typecheck:playground": "tsc -p tsconfig.playground.json",
    "smoke:playground": "pnpm build && node examples/playground/smoke.browser.mjs",
    "size:composed": "size-limit",
    "profile": "pnpm build && node bench/device-profile.mjs",
    "profile:all": "pnpm build && node bench/device-profile.mjs --browser all",
    "profile:check": "pnpm build && node bench/device-profile.mjs --browser all --check"
  },
  "devDependencies": {
    "@angular/core": "22.1.4",
    "@changesets/cli": "3.0.1",
    "@size-limit/preset-small-lib": "13.0.3",
    "@types/node": "22.10.5",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.2.0",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "ng-packagr": "22.0.1",
    "playwright": "1.62.1",
    "size-limit": "13.0.3",
    "turbo": "2.10.12",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  },
  "size-limit": [
    {
      "name": "the whole grid a consumer downloads",
      "path": "bench/composed/index.js",
      "limit": "16 KB"
    }
  ]
}
