{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@oxygenui-design/*": [
        "packages/*/dist/index.d.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "examples/playground/*.ts",
    "examples/playground/*.mts",
    "examples/playground/*.mjs"
  ]
}
