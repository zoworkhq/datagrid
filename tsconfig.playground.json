{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@oxygenui-design/*": [
        "packages/*/dist/index.d.ts"
      ],
      "react": [
        "packages/grid-react/node_modules/@types/react"
      ],
      "react-dom/client": [
        "packages/grid-react/node_modules/@types/react-dom/client"
      ]
    },
    "allowJs": true,
    "typeRoots": [
      "node_modules/@types",
      "packages/grid-react/node_modules/@types"
    ]
  },
  "include": [
    "examples/playground/*.mjs",
    "examples/playground/*.mts",
    "examples/playground/*.ts",
    "examples/site/*.mjs",
    "examples/site/*.ts"
  ]
}
