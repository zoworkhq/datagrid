{
  "name": "@oxygenui-design/grid-signals",
  "version": "0.0.0",
  "private": true,
  "description": "The reactivity substrate: a facade over a signals implementation",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --passWithNoTests",
    "size": "size-limit"
  },
  "oxygen": {
    "layer": "engine",
    "budget": "3 KB",
    "wave": 1
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "3 KB"
    }
  ],
  "dependencies": {
    "alien-signals": "3.2.1"
  }
}
