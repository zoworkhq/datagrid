{
  "name": "@oxygenui-design/grid-core",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-free grid engine: row models, columns, sort, filter, selection, geometry",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --passWithNoTests",
    "size": "size-limit"
  },
  "oxygen": {
    "layer": "engine",
    "budget": "22 KB",
    "wave": 1
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "22 KB",
      "ignore": [
        "@oxygenui-design/grid-signals"
      ]
    }
  ],
  "dependencies": {
    "@oxygenui-design/grid-signals": "workspace:*"
  }
}
