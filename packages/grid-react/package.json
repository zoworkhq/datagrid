{
  "name": "@oxygenui-design/grid-react",
  "version": "0.0.0",
  "private": true,
  "description": "React binding. Binding only - no grid logic lives here",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --passWithNoTests",
    "size": "size-limit"
  },
  "oxygen": {
    "layer": "adapter",
    "budget": "4 KB",
    "wave": 1
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "4 KB",
      "ignore": [
        "@oxygenui-design/grid-core",
        "@oxygenui-design/grid-dom",
        "react",
        "react-dom"
      ]
    }
  ],
  "dependencies": {
    "@oxygenui-design/grid-core": "workspace:*",
    "@oxygenui-design/grid-dom": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@oxygenui-design/grid-healthcare": "workspace:*"
  }
}
