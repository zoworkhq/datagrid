{
  "name": "@oxygenui-design/grid-element",
  "version": "0.0.0",
  "private": true,
  "description": "<ox-data-grid> custom element. Light DOM only. Binding only - no grid logic.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --passWithNoTests",
    "size": "size-limit"
  },
  "oxygen": {
    "layer": "adapter",
    "budget": "6 KB",
    "wave": 4
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "6 KB",
      "ignore": [
        "@oxygenui-design/grid-core",
        "@oxygenui-design/grid-dom"
      ]
    }
  ],
  "dependencies": {
    "@oxygenui-design/grid-core": "workspace:*",
    "@oxygenui-design/grid-dom": "workspace:*"
  },
  "devDependencies": {
    "@oxygenui-design/grid-react": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
