{
  "name": "@oxygenui-design/grid-fhir",
  "version": "0.0.0",
  "private": true,
  "description": "A Bundle-driven data source that follows link.next and is honest about absent totals",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --passWithNoTests",
    "size": "size-limit"
  },
  "oxygen": { "layer": "domain", "budget": "9 KB", "wave": 4 },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "9 KB",
      "ignore": ["@oxygenui-design/grid-core", "@oxygenui-design/grid-dom", "@oxygenui-design/grid-healthcare"]
    }
  ],
  "dependencies": {
    "@oxygenui-design/grid-core": "workspace:*",
    "@oxygenui-design/grid-healthcare": "workspace:*"
  }
}
