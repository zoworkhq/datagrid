{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-ng",
    "composite": false,
    "declarationMap": false,
    "experimentalDecorators": false,
    "useDefineForClassFields": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts"],
  "angularCompilerOptions": { "compilationMode": "partial", "strictTemplates": true }
}
