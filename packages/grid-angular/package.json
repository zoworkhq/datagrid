{
  "name": "@oxygenui-design/grid-angular",
  "version": "0.0.0",
  "private": true,
  "description": "Angular binding over Angular signals. Binding only - no grid logic.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && node scripts/flatten.mjs",
    "test": "vitest run --passWithNoTests",
    "size": "size-limit"
  },
  "oxygen": {
    "layer": "adapter",
    "budget": "8 KB",
    "wave": 4
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "8 KB",
      "ignore": [
        "@oxygenui-design/grid-core",
        "@oxygenui-design/grid-dom",
        "@angular/core"
      ]
    }
  ],
  "dependencies": {
    "@oxygenui-design/grid-core": "workspace:*",
    "@oxygenui-design/grid-dom": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=18"
  },
  "devDependencies": {
    "@angular/core": "22.1.4",
    "ng-packagr": "22.0.1",
    "typescript": "6.0.3"
  }
}
